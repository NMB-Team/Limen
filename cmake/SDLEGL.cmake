function(limen_patch_sdl_egl)
	get_target_property(_target SDL3::SDL3-static ALIASED_TARGET)
	if(NOT _target)
		set(_target SDL3::SDL3-static)
	endif()
	get_target_property(_imported ${_target} IMPORTED)
	if(_imported)
		message(STATUS "Prebuilt SDL must provide EGL reset-notification support")
		return()
	endif()

	get_target_property(_sources ${_target} SOURCES)
	foreach(_source IN LISTS _sources)
		if(NOT _source MATCHES "/SDL_egl\\.c$")
			continue()
		endif()

		file(READ "${_source}" _content)
		if(_content MATCHES "gl_config.reset_notification")
			return()
		endif()

		set(_marker "    // Set the context version and other attributes.")
		string(FIND "${_content}" "${_marker}" _position)
		if(_position EQUAL -1)
			message(FATAL_ERROR "Unsupported SDL EGL context builder: ${_source}")
		endif()

		set(_helper "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../backend/src/platform/egl_robustness.h")
		file(TO_CMAKE_PATH "${_helper}" _helper)
		set(_setup "    // limen: negotiate reset notification without replacing application callbacks\n")
		string(APPEND _setup "    EGLint context_flags = _this->gl_config.flags;\n")
		string(APPEND _setup "    if (!limen_egl_robustness(attribs, &attr, &context_flags,\n")
		string(APPEND _setup "        _this->egl_data->egl_version_major > 1 || (_this->egl_data->egl_version_major == 1 && _this->egl_data->egl_version_minor >= 5),\n")
		string(APPEND _setup "        SDL_EGL_HasExtension(_this, SDL_EGL_DISPLAY_EXTENSION, \"EGL_EXT_create_context_robustness\"),\n")
		string(APPEND _setup "        SDL_EGL_HasExtension(_this, SDL_EGL_DISPLAY_EXTENSION, \"EGL_KHR_create_context\"),\n")
		string(APPEND _setup "        profile_es, _this->gl_config.reset_notification == SDL_GL_CONTEXT_RESET_LOSE_CONTEXT)) {\n        return NULL;\n    }\n\n")
		string(APPEND _setup "${_marker}")
		string(REPLACE "${_marker}" "${_setup}" _content "${_content}")
		string(REPLACE "_this->gl_config.flags == 0" "context_flags == 0" _content "${_content}")
		string(REPLACE "if (_this->gl_config.flags != 0)" "if (context_flags != 0)" _content "${_content}")
		string(REPLACE "attribs[attr++] = _this->gl_config.flags;" "attribs[attr++] = context_flags;" _content "${_content}")
		string(REPLACE "#ifdef SDL_VIDEO_OPENGL_EGL" "#ifdef SDL_VIDEO_OPENGL_EGL\n#include \"${_helper}\"" _content "${_content}")

		set(_output "${CMAKE_CURRENT_BINARY_DIR}/limen-sdl/SDL_egl.c")
		file(CONFIGURE OUTPUT "${_output}" CONTENT "${_content}" @ONLY)
		list(FIND _sources "${_source}" _index)
		list(REMOVE_AT _sources ${_index})
		list(INSERT _sources ${_index} "${_output}")
		set_property(TARGET ${_target} PROPERTY SOURCES "${_sources}")
		get_filename_component(_directory "${_source}" DIRECTORY)
		target_include_directories(${_target} PRIVATE "${_directory}")
		set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_source}" "${_helper}")
		return()
	endforeach()
endfunction()
